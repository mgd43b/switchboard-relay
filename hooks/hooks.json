{
  "description": "Claude Code: keep switchboard participants listening between turns (standby is on by default; standby(false) or SWITCHBOARD_AUTO=0 opts out).",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:switchboard-relay:switchboard-relay",
            "tool": "host_standby",
            "input": {
              "timeout_s": 900
            },
            "timeout": 960,
            "statusMessage": "Listening for switchboard messages"
          }
        ]
      }
    ]
  }
}
